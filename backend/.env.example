# Mongo connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campusrent

# Any long random secret for JWT signing
JWT_SECRET=change_this_to_a_long_random_secret

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Comma separated list of allowed frontend origins (Vite dev server default: 5173)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5500
